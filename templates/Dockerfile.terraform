# Install Terraform from the HashiCorp repository
ARG UBUNTU_CODENAME

RUN set -eux; \
    mkdir -p /etc/apt/keyrings; \
    curl -fsSL https://apt.releases.hashicorp.com/gpg \
        | gpg --dearmor > /etc/apt/keyrings/hashicorp.gpg; \
    chmod go+r /etc/apt/keyrings/hashicorp.gpg; \
    echo "deb [arch=arm64 signed-by=/etc/apt/keyrings/hashicorp.gpg] https://apt.releases.hashicorp.com ${UBUNTU_CODENAME} main" > /etc/apt/sources.list.d/hashicorp.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends terraform; \
    rm -rf /var/lib/apt/lists/*

# Register the Terraform bash completion
RUN printf '%s\n' 'complete -C /usr/bin/terraform terraform' > /etc/bash_completion.d/terraform
